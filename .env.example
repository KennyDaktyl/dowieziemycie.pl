# Copy to .env and adjust for your machine. Used by docker-compose and by
# backend/config/settings.py (loaded via python-dotenv).

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required in production (behind HTTPS) for Django's CSRF check to accept
# POSTs like the admin login — must include the scheme, e.g. https://api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Leave unset for local dev (relative "media/" works fine same-origin). In
# production set to the full public URL, e.g. https://api.example.com/media/ —
# otherwise DRF bakes whatever internal host made the request (e.g.
# http://127.0.0.1:1600) into image URLs sent to the browser.
MEDIA_URL=

# --- Database ---
# Leave DJANGO_DB_ENGINE unset for local sqlite dev without Docker.
# Set to "postgres" when running via docker-compose.
DJANGO_DB_ENGINE=postgres
POSTGRES_DB=dowieziemycie
POSTGRES_USER=dowieziemycie
POSTGRES_PASSWORD=dowieziemycie
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Channels ---
# Leave unset to fall back to the in-memory channel layer (single process only).
REDIS_URL=redis://redis:6379/0

# --- Routing / ETA (Phase 4) ---
OSRM_BASE_URL=http://osrm:5000

# --- SMS OTP gateway ---
# "console" logs the OTP code to the backend logs — safe default for dev.
# Set to "smsapi" in production to send real SMS through SMSAPI.pl.
SMS_BACKEND=console
SMSAPI_TOKEN=
SMSAPI_SENDER_NAME=

# --- Stripe (deposit payments — BLIK/card, embedded via Payment Element) ---
# One shared account for both brands. Empty = payment endpoints return a
# clear "not configured yet" error instead of crashing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe Dashboard webhook endpoint you register for
# POST /api/payments/stripe-webhook/ (or `stripe listen` output locally).
STRIPE_WEBHOOK_SECRET=

# --- Frontend (Next.js) ---
# Server-side (Server Components / Route Handlers, proxies auth calls so the
# JWT never reaches the browser) and client-side (public polling endpoints
# like live driver status) — same value in dev, can diverge behind Docker.
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
# Used to build absolute URLs in sitemap.xml/robots.txt — set to the real
# production domain once deployed.
NEXT_PUBLIC_SITE_URL=https://dowieziemycie.pl
